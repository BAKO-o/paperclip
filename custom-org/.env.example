# Custom AI Organization — Environment Variables
# 이 파일을 복사해서 .env를 만들고 실제 값을 채워주세요:
#   cp .env.example .env

# ── 필수 ──────────────────────────────────────────────────────────────────────

# Anthropic API Key (Claude Code 에이전트 실행에 필요)
ANTHROPIC_API_KEY=sk-ant-...

# ── 선택 ──────────────────────────────────────────────────────────────────────

# 조직 루트 디렉토리 (기본값: 스크립트 위치 기준 자동 감지)
# ORG_COMPANY_DIR=/path/to/custom-org

# 대시보드 서버 포트 (기본값: 8080)
# DASHBOARD_PORT=8080

# 하트비트 실행 간격 크론 표현식 (기본값: 30분마다)
# HEARTBEAT_CRON=*/30 * * * *

# Claude 모델 (기본값: claude-sonnet-4-6)
# HEARTBEAT_MODEL=claude-sonnet-4-6

# 하트비트 로그 디렉토리 (기본값: state/heartbeat-logs)
# HEARTBEAT_LOG_DIR=state/heartbeat-logs

# GitHub Personal Access Token (CI 워크플로우 검증용, 선택)
# GH_TOKEN=ghp_...

# ── EC2 배포 (CD 파이프라인용) ──────────────────────────────────────────────

# EC2_HOST=ec2-xxx.compute.amazonaws.com
# EC2_USER=ubuntu
# EC2_SSH_KEY=<GitHub Secret에 저장 — 로컬 환경에서는 불필요>
